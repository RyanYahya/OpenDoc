+            words.trim_end(),
+            json!({ "direction": "rtl", "width": { "Pt": 120 } })
+        )]));
+        let lines = lines(&pages);
+        assert!(
+            lines.len() >= 4,
+            "expected wrapping, got {} lines",
+            lines.len()
+        );
+        let texts = info_texts(&pages);
+        assert_eq!(
+            texts.join(" ").split_whitespace().collect::<Vec<_>>(),
+            words.split_whitespace().collect::<Vec<_>>()
+        );
+        for (el, logical) in lines.iter().zip(&texts) {
+            // Each line on its own: words in reverse order, Arabic letters
+            // reversed, Latin words left to right.
+            let expected: Vec<String> = logical
+                .split(' ')
+                .rev()
+                .map(|w| {
+                    if w.is_ascii() {
+                        w.to_string()
+                    } else {
+                        w.chars().rev().collect()
+                    }
+                })
+                .collect();
+            assert_eq!(visual(el), expected.join(" "));
+            assert!((el.x + el.width - (LEFT + 120.0)).abs() < 0.01);
+        }
+    }
+
+    #[test]
+    fn justified_rtl_paragraph_ends_on_a_right_aligned_line() {
+        let words = "ابج abc ".repeat(12);
+        let (pages, _) = layout(json!([text(
+            words.trim_end(),
+            json!({ "direction": "rtl", "width": { "Pt": 120 }, "textAlign": "Justify" })
+        )]));
+        let lines = lines(&pages);
+        let (last, rest) = lines.split_last().unwrap();
+        for el in rest {
+            assert!((el.x - LEFT).abs() < 0.01 && (el.width - 120.0).abs() < 0.01);
+        }
+        assert!((last.x + last.width - (LEFT + 120.0)).abs() < 0.01);
+    }
+
+    #[test]
+    fn ltr_paragraph_with_rtl_word_keeps_its_direction() {
+        let (pages, _) = layout(json!([text("abc ابج def", json!({}))]));
+        let lines = lines(&pages);
+        assert_eq!(visual(&lines[0]), "abc جبا def");
+        assert!((lines[0].x - LEFT).abs() < 0.01);
+    }
+
+    #[test]
+    fn rtl_brackets_are_mirrored_for_unshaped_fonts() {
+        let (pages, _) = layout(json!([text("ابج (دهو)", json!({ "direction": "rtl" }))]));
+        // Visual: the logical closing bracket is drawn first, mirrored.
+        assert_eq!(visual(&lines(&pages)[0]), "(وهد) جبا");
+    }
+
+    #[test]
+    fn rtl_flex_row_starts_at_the_right() {
+        let row = json!({
+            "kind": { "type": "View" },
+            "style": { "flexDirection": "Row", "direction": "rtl" },
+            "children": [
+                text("first", json!({ "width": { "Pt": 100 } })),
+                text("second", json!({ "width": { "Pt": 50 } })),
+            ]
+        });
+        let (pages, _) = layout(json!([row]));
+        let row = &pages[0].elements[0];
+        assert!((row.children[0].x - (LEFT + WIDTH - 100.0)).abs() < 0.01);
+        assert!((row.children[1].x - (LEFT + WIDTH - 150.0)).abs() < 0.01);
+    }
+
+    #[test]
+    fn rtl_table_starts_with_the_right_column() {
+        let table = json!({
+            "kind": { "type": "Table", "columns": [{ "width": { "Fraction": 0.25 } }, { "width": { "Fraction": 0.75 } }] },
+            "style": { "direction": "rtl" },
+            "children": [{
+                "kind": { "type": "TableRow", "is_header": false },
+                "style": {},
+                "children": [
+                    { "kind": { "type": "TableCell", "col_span": 1, "row_span": 1 }, "style": {}, "children": [text("a", json!({}))] },
+                    { "kind": { "type": "TableCell", "col_span": 1, "row_span": 1 }, "style": {}, "children": [text("b", json!({}))] }
+                ]
+            }]
+        });
+        let (pages, _) = layout(json!([table]));
+        fn cells(e: &[LayoutElement], out: &mut Vec<(f64, f64)>) {
+            for el in e {
+                if el.node_type.as_deref() == Some("TableCell") {
+                    out.push((el.x, el.width));
+                }
+                cells(&el.children, out);
+            }
+        }
+        let mut found = Vec::new();
+        cells(&pages[0].elements, &mut found);
+        assert_eq!(found.len(), 2);
+        assert!(
