+/// Shape one directional run with an explicit direction.
+///
+/// The script is still guessed from the text. Right-to-left runs come back in
+/// visual (left-to-right) order with contextual forms and mirrored glyphs;
+/// left-to-right runs keep logical order even when they contain only
+/// neutral characters such as digits inside a right-to-left paragraph.
+pub fn shape_run(text: &str, font_data: &[u8], rtl: bool) -> Option<Vec<ShapedGlyph>> {
+    let face = rustybuzz::Face::from_slice(font_data, 0)?;
+    let mut buffer = rustybuzz::UnicodeBuffer::new();
+    buffer.push_str(text);
+    buffer.set_direction(if rtl {
+        rustybuzz::Direction::RightToLeft
+    } else {
+        rustybuzz::Direction::LeftToRight
+    });
+    let output = rustybuzz::shape(&face, &[], buffer);
+    let mut char_index = std::collections::HashMap::new();
+    for (ci, (bi, _)) in text.char_indices().enumerate() {
+        char_index.insert(bi, ci);
+    }
+    Some(
+        output
+            .glyph_infos()
+            .iter()
+            .zip(output.glyph_positions())
+            .map(|(info, pos)| ShapedGlyph {
+                glyph_id: info.glyph_id as u16,
+                cluster: char_index
+                    .get(&(info.cluster as usize))
+                    .copied()
+                    .unwrap_or(0) as u32,
+                x_advance: pos.x_advance,
+                y_advance: pos.y_advance,
+                x_offset: pos.x_offset,
+                y_offset: pos.y_offset,
+            })
+            .collect(),
+    )
+}
+
+/// Source text for each shaped glyph of one run.
+///
+/// The glyphs of a cluster are contiguous; HarfBuzz reverses right-to-left
+/// output as a whole, so within a cluster they are in logical order only for
+/// left-to-right runs. A single glyph receives the whole cluster (ligatures
+/// such as lam-alef). Otherwise the first spacing glyph in logical order (the
+/// base) receives the first character plus any surplus, and the remaining
+/// characters (marks) go to the remaining glyphs in logical order. Extra
+/// glyphs of a decomposed character, such as the separate dot glyphs of
+/// some Arabic fonts, receive no text.
+pub fn glyph_texts(glyphs: &[ShapedGlyph], chars: &[char], rtl: bool) -> Vec<String> {
+    let mut texts = vec![String::new(); glyphs.len()];
+    let mut i = 0;
+    while i < glyphs.len() {
+        let cluster = glyphs[i].cluster as usize;
+        let mut j = i + 1;
+        while j < glyphs.len() && glyphs[j].cluster as usize == cluster {
+            j += 1;
+        }
+        let end = glyphs
+            .iter()
+            .map(|g| g.cluster as usize)
+            .filter(|&c| c > cluster)
+            .min()
+            .unwrap_or(chars.len())
+            .min(chars.len());
+        let source = &chars[cluster.min(end)..end];
+        let mut logical: Vec<usize> = (i..j).collect();
+        if rtl {
+            logical.reverse();
+        }
+        let base = logical
+            .iter()
+            .position(|&g| glyphs[g].x_advance != 0)
+            .unwrap_or(0);
+        let surplus = source.len().saturating_sub(logical.len());
+        let mut rest = source.iter().skip(1 + surplus);
+        for (k, &g) in logical.iter().enumerate() {
+            texts[g] = if k == base {
+                source.iter().take(1 + surplus).collect()
+            } else {
+                rest.next().map(|ch| ch.to_string()).unwrap_or_default()
+            };
+        }
+        i = j;
+    }
+    texts
+}
