+#[cfg(test)]
+mod bidi_tests {
+    //! Paragraph-level bidi layout. Standard fonts keep these independent of
+    //! font files: glyph order, alignment, and mirroring do not depend on
+    //! glyph coverage.
+    use super::*;
+    use crate::font::FontContext;
+    use serde_json::{json, Value};
+
+    const LEFT: f64 = 40.0;
+    const WIDTH: f64 = 515.28; // A4 minus 40 pt margins
+
+    fn layout(children: Value) -> (Vec<LayoutPage>, Vec<String>) {
+        let doc: Document = serde_json::from_value(json!({
+            "children": [{
+                "kind": { "type": "Page", "config": {
+                    "size": "A4",
+                    "margin": { "top": 40, "right": 40, "bottom": 40, "left": 40 },
+                    "wrap": true
+                } },
+                "style": {},
+                "children": children
+            }],
+            "metadata": {},
+            "defaultPage": { "size": "A4", "margin": { "top": 40, "right": 40, "bottom": 40, "left": 40 }, "wrap": true }
+        }))
+        .expect("valid document");
+        let engine = LayoutEngine::new();
+        let pages = engine.layout(&doc, &FontContext::new());
+        let warnings = engine.take_warnings();
+        (pages, warnings)
+    }
+
+    fn text(content: &str, style: Value) -> Value {
+        json!({ "kind": { "type": "Text", "content": content }, "style": style, "children": [] })
+    }
+
+    fn text_lines(elements: &[LayoutElement], out: &mut Vec<LayoutElement>) {
+        for el in elements {
+            if el.node_type.as_deref() == Some("TextLine") {
+                out.push(el.clone());
+            }
+            text_lines(&el.children, out);
+        }
+    }
+
+    fn lines(pages: &[LayoutPage]) -> Vec<LayoutElement> {
+        let mut out = Vec::new();
+        for page in pages {
+            text_lines(&page.elements, &mut out);
+        }
+        out
+    }
+
+    fn line(el: &LayoutElement) -> &TextLine {
+        match &el.draw {
+            DrawCommand::Text { lines, .. } => &lines[0],
+            _ => panic!("TextLine without text"),
+        }
+    }
+
+    fn visual(el: &LayoutElement) -> String {
+        line(el).glyphs.iter().map(|g| g.char_value).collect()
+    }
+
+    fn info_texts(pages: &[LayoutPage]) -> Vec<String> {
+        fn walk(e: &[ElementInfo], out: &mut Vec<String>) {
+            for el in e {
+                if el.node_type == "TextLine" {
+                    out.push(el.text_content.clone().unwrap_or_default());
+                }
+                walk(&el.children, out);
+            }
+        }
+        let mut out = Vec::new();
+        for page in LayoutInfo::from_pages(pages).pages {
+            walk(&page.elements, &mut out);
+        }
+        out
+    }
