+            "{found:?}"
+        );
+        assert!((found[1].0 - LEFT).abs() < 0.01, "{found:?}");
+    }
+
+    #[test]
+    fn missing_rtl_glyphs_are_reported() {
+        let (_, warnings) = layout(json!([text("abc ابج", json!({ "direction": "auto" }))]));
+        assert!(
+            warnings
+                .iter()
+                .any(|w| w.starts_with("Missing glyphs") && w.contains("U+0627")),
+            "{warnings:?}"
+        );
+    }
+
+    #[test]
+    fn layout_info_reports_direction() {
+        let (pages, _) = layout(json!([
+            text("abc", json!({ "direction": "auto" })),
+            text("ابج", json!({ "direction": "auto" })),
+        ]));
+        let info = serde_json::to_value(LayoutInfo::from_pages(&pages)).unwrap();
+        let elements = &info["pages"][0]["elements"];
+        assert_eq!(elements[0]["style"]["direction"], "auto");
+        assert_eq!(elements[0]["children"][0]["style"]["direction"], "ltr");
+        assert_eq!(elements[1]["children"][0]["style"]["direction"], "rtl");
+        assert_eq!(elements[1]["children"][0]["style"]["textAlign"], "Right");
+    }
+}
