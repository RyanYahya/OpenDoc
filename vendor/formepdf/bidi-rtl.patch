+    #[test]
+    fn rtl_paragraph_orders_runs_visually_and_reports_logical_text() {
+        let (pages, _) = layout(json!([text("abc ابج def.", json!({ "direction": "rtl" }))]));
+        let lines = lines(&pages);
+        assert_eq!(lines.len(), 1);
+        // UAX#9: Latin runs stay left to right inside the right-to-left line;
+        // the final period belongs to the paragraph and sits at the far left.
+        assert_eq!(visual(&lines[0]), ".def جبا abc");
+        assert_eq!(info_texts(&pages), vec!["abc ابج def."]);
+        let style = lines[0].resolved_style.as_ref().unwrap();
+        assert_eq!(style.direction, Direction::Rtl);
+        assert!(matches!(style.text_align, TextAlign::Right));
+        let right = lines[0].x + lines[0].width;
+        assert!(
+            (right - (LEFT + WIDTH)).abs() < 0.01,
+            "right aligned, ends at {right}"
+        );
+        // Glyphs are placed left to right without gaps or overlaps.
+        let glyphs = &line(&lines[0]).glyphs;
+        for pair in glyphs.windows(2) {
+            assert!((pair[0].x_offset + pair[0].x_advance - pair[1].x_offset).abs() < 1e-9);
+        }
+    }
