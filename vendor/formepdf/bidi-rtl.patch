+                { "content": "abc " },
+                { "content": "ابج", "style": { "fontWeight": 700 } },
+                { "content": " def." }
+            ] },
+            "style": { "direction": "rtl" },
+            "children": []
+        });
+        let (pages, _) = layout(json!([runs]));
+        let lines = lines(&pages);
