+/// A single run carrying a plain Text node's content when that content needs
+/// the bidi pipeline; `None` keeps the left-to-right single-style path.
+fn bidi_content_runs(content: &str, style: &ResolvedStyle) -> Option<Vec<TextRun>> {
+    if !bidi::needs_bidi(&substitute_page_placeholders(content), style.direction) {
+        return None;
+    }
+    Some(vec![TextRun {
+        content: content.to_string(),
+        // Letter spacing is not inherited by runs; everything else is.
+        style: Style {
+            letter_spacing: Some(style.letter_spacing),
+            ..Default::default()
+        },
+        href: None,
+    }])
+}
+
+/// Resolve UAX#9 embedding levels across a whole paragraph (all of a Text
+/// node's styled runs) when it needs the bidi pipeline.
+fn annotate_bidi(chars: &mut [StyledChar], direction: Direction) {
+    let text: String = chars.iter().map(|sc| sc.ch).collect();
+    if !bidi::needs_bidi(&text, direction) {
+        return;
+    }
+    for (sc, state) in chars
+        .iter_mut()
+        .zip(bidi::paragraph_levels(&text, direction))
+    {
+        sc.bidi = Some(state);
+    }
+}
+
+/// Alignment of one line. Without an explicit `textAlign` anywhere in the
+/// inheritance chain, a line starts at its paragraph's resolved direction
+/// (CSS `start`); the last line of a justified paragraph does too.
+fn line_text_align(style: &ResolvedStyle, rtl: bool, is_last_line: bool) -> TextAlign {
+    let start = if rtl {
+        TextAlign::Right
+    } else {
+        TextAlign::Left
+    };
+    match style.text_align {
+        TextAlign::Justify if is_last_line => start,
+        TextAlign::Justify => TextAlign::Justify,
+        _ if style.text_align_from_direction => start,
+        align => align,
+    }
+}
+
+/// Style reported for a TextLine: the resolved paragraph direction and the
+/// applied alignment (justified paragraphs stay `Justify`).
+fn line_resolved_style(style: &ResolvedStyle, rtl: bool, align: TextAlign) -> ResolvedStyle {
+    let mut line = style.clone();
+    line.direction = if rtl { Direction::Rtl } else { Direction::Ltr };
+    if !matches!(style.text_align, TextAlign::Justify) {
+        line.text_align = align;
+    }
+    line
+}
