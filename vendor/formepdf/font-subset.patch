+    #[test]
+    fn test_table_directory_excludes_alignment_padding() {
+        // Two glyphs need three short loca entries: six bytes, not eight.
+        let loca = build_loca(&[0, 2, 4], 0);
+        let name = vec![1, 2, 3];
+        let tables = vec![
+            (tag_u32(b"loca"), loca.clone()),
+            (tag_u32(b"name"), name.clone()),
+        ];
+        let output = write_ttf_file(&tables);
+
+        assert_eq!(find_table(&output, b"loca").unwrap(), loca);
+        assert_eq!(find_table(&output, b"name").unwrap(), name);
+        for index in 0..tables.len() {
+            let directory = 12 + index * 16;
+            let offset = read_u32(&output, directory + 8) as usize;
+            let length = read_u32(&output, directory + 12) as usize;
+            let padded_end = (offset + length + 3) & !3;
+            assert_eq!(offset % 4, 0);
+            assert!(output[offset + length..padded_end]
+                .iter()
+                .all(|byte| *byte == 0));
+        }
+    }
